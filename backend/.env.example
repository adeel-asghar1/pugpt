# Copy this file to .env and adjust the values as needed.

# --- Generation provider ---
# Groq hosted LLM (OpenAI-compatible chat completions) — used for answer
# GENERATION only; embeddings stay on local Ollama nomic-embed-text.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Timeout (seconds) for Groq requests.
GROQ_TIMEOUT=120
# Which provider generates answers: auto | groq | ollama
#   auto   -> groq when GROQ_API_KEY is set, otherwise ollama (default).
#   groq   -> force Groq; a missing key fails fast with a clear error.
#   ollama -> keep local Ollama generation (pre-Groq behavior).
# There is NO automatic fallback between providers.
LLM_PROVIDER=auto

# --- Local Ollama (optional; only required if EMBEDDING_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
# Timeout (seconds) for HTTP requests to Ollama.
OLLAMA_TIMEOUT=30
# Timeout (seconds) for answer generation (CPU generation can be slow).
OLLAMA_CHAT_TIMEOUT=120

# --- Embedding provider & ChromaDB collection (must match!) ---
# EMBEDDING_PROVIDER picks the embedding engine for BOTH indexing and querying.
#   fastembed (default) -> nomic-ai/nomic-embed-text-v1.5-Q, fully in-process,
#                         no Ollama daemon required, CPU (~200 MB RSS).
#   ollama              -> http://OLLAMA_BASE_URL/api/embed with OLLAMA_EMBED_MODEL.
EMBEDDING_PROVIDER=fastembed
# Embedding model for the FastEmbed provider (fixed for current deployment).
FASTEMBED_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5-Q
# Collection to read/write. MUST match the provider's vector space:
#   fastembed provider -> pugpt_knowledge_fastembed_test   (built with FastEmbed)
#   ollama provider    -> pugpt_knowledge                  (original 519 vectors)
CHROMA_COLLECTION=pugpt_knowledge_fastembed_test

CORS_ORIGINS=http://localhost:5173

RETRIEVAL_TOP_K=4
# Chunks retrieved per RAG question (top-k).
RAG_TOP_K=5
# Cosine distance (1 - cosine similarity); lower = more similar.
# Chunks farther than this are treated as weakly relevant and discarded.
RAG_DISTANCE_THRESHOLD=0.5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# Chunks embedded per Ollama /api/embed request during ingestion
INGESTION_BATCH_SIZE=16

# ChromaDB storage directory (defaults to backend/data/chroma if unset)
# CHROMA_PERSIST_PATH=C:\path\to\chroma
CHROMA_COLLECTION=pugpt_knowledge

# --- Official PU live web search (FALLBACK only; DISABLED by default) ---
# Tavily (https://app.tavily.com) — free tier: 1,000 API credits/month,
# recurring, no credit card required. Basic search depth = 1 credit per
# fallback search; PUGPT only searches when ChromaDB has no relevant PDF
# context, or the question explicitly asks for current/latest information.
# Trusted sources: pu.edu.pk and its subdomains only (enforced server-side).
# There are NO automatic retries; quota exhaustion degrades to the existing
# safe refusal. Your real key goes in .env ONLY — never commit it.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
# Allow live search for explicit current/latest questions even when the PDF
# context exists (each such answer consumes 1 Tavily credit).
WEB_SEARCH_ON_RECENCY=true
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_ALLOWED_SUFFIXES=pu.edu.pk

# --- Rate limiting (public API protection) ---
# Fixed-window per-client-IP limit for POST /api/chat only (not /api/health).
# In-memory, single worker. Invalid values fall back to these safe defaults.
RATE_LIMIT_CHAT=10
RATE_LIMIT_WINDOW_SECONDS=60
# Set true ONLY when PUGPT runs behind a reverse proxy that guarantees a
# correct X-Forwarded-For for the real client IP. When enabled, the RIGHTMOST
# X-Forwarded-For entry is trusted (the address the proxy observed).
# Leave false otherwise — clients may send arbitrary X-Forwarded-For headers.
RATE_LIMIT_TRUST_PROXY=false

# Global daily chat limit (application-wide, per UTC calendar day), persisted
# in SQLite so it survives restarts/reloads. 500 accepted requests/day by
# default; per-IP limit applies on top. Counter stores only the UTC date and
# a count — never prompts, answers, IPs or identities. On storage failure the
# API fails CLOSED (requests refused with HTTP 503).
# Invalid values fall back to 500 (a non-numeric value fails startup).
MAX_CHAT_REQUESTS_PER_DAY=500
# Where the SQLite counter lives. Override only with an ABSOLUTE path —
# default (backend/data/global_rate_limit.sqlite3) is recommended.
# RATE_LIMIT_GLOBAL_DB_PATH=
